# Copy this file to `.env` (same folder) and fill in the values.
# NEVER commit .env - it is listed in .gitignore.

# ---------- Required ----------
# development | production
NODE_ENV=development
PORT=5050

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# Include a database name before the "?", e.g. ...mongodb.net/lostfound?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign login tokens (64+ characters recommended).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed to call this API (CORS). Comma-separate several.
# Also used to build the links inside verification / reset emails (first entry).
CLIENT_URL=http://localhost:5180

# Allowed college email domains, comma-separated, without "@".
# Example: mycollege.edu,students.mycollege.edu
COLLEGE_EMAIL_DOMAINS=

# Require users to click an emailed link before using the portal.
# Currently OFF (college OAuth sign-in is planned). The domain allowlist above
# always applies. Set to true to turn email verification back on.
REQUIRE_EMAIL_VERIFICATION=false

# ---------- Cloudinary (image storage) ----------
# Required in production. If left empty in development, images are saved to
# server/uploads/ instead (local dev only - they are NOT persistent on Render).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campus-lost-found

# ---------- Email via SMTP (verification + password reset) ----------
# Needed for password-reset emails (and for verification if turned on).
# If left empty in development, emails are printed to the server terminal
# instead ("dev email mode"). In production without SMTP, password reset is
# simply unavailable - links are never shown in the browser.
# Brevo example: SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender shown to users, e.g.  Boomerang <no-reply@yourdomain.com>
# Must be a sender address you verified with your email provider.
EMAIL_FROM=

# ---------- Sign in with Google (OAuth) ----------
# Web client ID from Google Cloud > APIs & Services > Credentials. It is public
# (no client secret is used). Add your site URLs as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# true = turn off email + password sign-in and allow Google only
GOOGLE_ONLY=false
